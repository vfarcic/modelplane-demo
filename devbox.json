{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": [
    "kind@0.32.0",
    "nushell@0.115.1",
    "kubernetes-helm@4.3.0",
    "kubectl@1.35.4",
    "vals@0.47.0",
    "git@2.55.0",
    "jq@1.8.2",
    "curl@8.22.0",
    "google-cloud-sdk@583.0.0"
  ],
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.local/bin:$HOME/.npm-global/bin:$PATH\"",
      "[ -n \"$USE_VALS\" ] && eval \"$(vals env -export -f .env.vals.yaml)\" || true",
      "[ -f .env ] && source .env || true"
    ],
    "scripts": {}
  }
}
